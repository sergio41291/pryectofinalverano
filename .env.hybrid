#=============================================================================
# LearnMind AI - Environment Variables (Hybrid Deployment)
# Docker: Solo infraestructura
# Native: Backend y Frontend en el host con PM2
#=============================================================================

# Application
NODE_ENV=production
APP_NAME=LearnMind AI
APP_URL=https://learnmind-ai.jkhoster.com
FRONTEND_URL=https://learnmind-ai.jkhoster.com
BACKEND_URL=https://learnmind-ai.jkhoster.com/api

#=============================================================================
# BACKEND (corriendo en host:3000 con PM2)
#=============================================================================
PORT=3000

#=============================================================================
# DATABASE - PostgreSQL (Docker container)
#=============================================================================
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=learnmind_user
DB_PASSWORD=CAMBIAR_POSTGRESQL_PASSWORD_SEGURA
DB_DATABASE=learnmind_production
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

#=============================================================================
# MONGODB (Docker container)
#=============================================================================
MONGODB_URI=mongodb://localhost:27017
MONGODB_USERNAME=learnmind_mongo
MONGODB_PASSWORD=CAMBIAR_MONGODB_PASSWORD_SEGURA
MONGODB_DATABASE=learnmind_ai
MONGODB_AUTH_SOURCE=admin

#=============================================================================
# REDIS (Docker container)
#=============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR_REDIS_PASSWORD_SEGURA
REDIS_DB=0
REDIS_TTL=3600

#=============================================================================
# MINIO - Object Storage (Docker container)
#=============================================================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CAMBIAR_MINIO_PASSWORD_SEGURA
MINIO_BUCKET=learnmind-documents
MINIO_REGION=us-east-1

#=============================================================================
# JWT Authentication
#=============================================================================
JWT_SECRET=CAMBIAR_JWT_SECRET_32_CARACTERES_ALEATORIOS
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=CAMBIAR_JWT_REFRESH_SECRET_32_CARACTERES
JWT_REFRESH_EXPIRES_IN=7d

#=============================================================================
# EXTERNAL APIs
#=============================================================================

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_ANTHROPIC_KEY_HERE

# Google Cloud (Translation API)
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_CREDENTIALS_PATH=./credentials/google-cloud-key.json

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_TEST_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

#=============================================================================
# EMAIL Configuration (SMTP)
#=============================================================================
EMAIL_HOST=mail.jkhoster.com
EMAIL_PORT=587
EMAIL_USER=noreply@jkhoster.com
EMAIL_PASSWORD=Cambiamejk1!.
EMAIL_FROM=noreply@jkhoster.com
EMAIL_SECURE=false

#=============================================================================
# FEATURE FLAGS
#=============================================================================
FEATURE_OCR_ENABLED=true
FEATURE_AUDIO_ENABLED=true
FEATURE_SUMMARIZE_ENABLED=true
FEATURE_MINDMAP_ENABLED=true
FEATURE_CONCEPTMAP_ENABLED=true
FEATURE_TRANSLATE_ENABLED=true
FEATURE_TTS_ENABLED=false
FEATURE_GROUPS_ENABLED=true
FEATURE_PAYMENTS_ENABLED=true

#=============================================================================
# RATE LIMITING
#=============================================================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

#=============================================================================
# CORS
#=============================================================================
CORS_ORIGIN=https://learnmind-ai.jkhoster.com
CORS_CREDENTIALS=true

#=============================================================================
# SSL/TLS
#=============================================================================
SSL_CERT_PATH=/etc/letsencrypt/live/learnmind-ai.jkhoster.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/learnmind-ai.jkhoster.com/privkey.pem
DOMAIN=learnmind-ai.jkhoster.com
EMAIL=jc.ulloa@jkarlos.info

#=============================================================================
# LOGGING
#=============================================================================
LOG_LEVEL=info
LOG_FILE_PATH=/home/sw1/pryectofinalverano/logs/app.log

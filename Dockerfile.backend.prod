# Production Dockerfile for Backend - Compile on server
FROM node:20-alpine

WORKDIR /app

# Configure DNS and install build dependencies
# Use multiple retries and alternative repositories for better reliability
RUN echo "nameserver 8.8.8.8" > /etc/resolv.conf && \
    echo "nameserver 1.1.1.1" >> /etc/resolv.conf && \
    apk update --no-cache && \
    apk add --no-cache --update \
        dumb-init \
        python3 \
        make \
        g++ \
        || (sleep 5 && apk add --no-cache dumb-init python3 make g++)

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev for building)
RUN npm ci --legacy-peer-deps

# Copy source code
COPY . .

# Build application on server
RUN npm run build

# Remove dev dependencies after build
RUN npm prune --production --legacy-peer-deps

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 && \
    chown -R nodejs:nodejs /app

USER nodejs

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3001/api/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

# Use dumb-init to handle signals
ENTRYPOINT ["dumb-init", "--"]

# Start application
CMD ["node", "dist/main"]

EXPOSE 3001

# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# LearnMind AI - VPS Deployment
# ============================================

NODE_ENV=production

# ============================================
# DATABASE - PostgreSQL
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=learnmind_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!
DB_NAME=learnmind_production
DB_LOGGING=false
DB_SYNCHRONIZE=false

# ============================================
# MONGODB
# ============================================
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_USER=learnmind_mongo
MONGO_PASSWORD=CHANGE_THIS_MONGO_PASSWORD_456!
MONGO_DB=learnmind_production
MONGO_URI=mongodb://learnmind_mongo:CHANGE_THIS_MONGO_PASSWORD_456!@mongodb:27017/learnmind_production?authSource=admin

# ============================================
# REDIS - Cache & Queue
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_789!
REDIS_DB=0
REDIS_URL=redis://:CHANGE_THIS_REDIS_PASSWORD_789!@redis:6379

# ============================================
# MINIO - Object Storage
# ============================================
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=learnmind_minio
MINIO_ROOT_PASSWORD=CHANGE_THIS_MINIO_PASSWORD_ABC!
MINIO_REGION=us-east-1
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_TEMP=temp
MINIO_BUCKET_RESULTS=results
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=learnmind_minio
MINIO_SECRET_KEY=CHANGE_THIS_MINIO_PASSWORD_ABC!
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============================================
# JWT - Authentication
# ============================================
JWT_SECRET=CHANGE_THIS_JWT_SECRET_MINIMUM_32_CHARACTERS_REQUIRED!
JWT_EXPIRES_IN=24h
JWT_EXPIRATION=900
JWT_REFRESH_SECRET=CHANGE_THIS_JWT_REFRESH_SECRET_MINIMUM_32_CHARS!
JWT_REFRESH_EXPIRATION=604800

# ============================================
# PADDLE OCR
# ============================================
PADDLE_OCR_LANG=es
PADDLE_OCR_LANG_MAIN=es
PADDLE_OCR_LANG_DICT=None
PADDLE_OCR_SHOW_LOG=false
PADDLE_OCR_GPU=false
PADDLE_OCR_GPU_ID=0
PADDLE_OCR_ENABLE=true

# ============================================
# CLAUDE API - AI Processing
# ============================================
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7
CLAUDE_TIMEOUT_MS=120000

# ============================================
# GOOGLE TRANSLATE API
# ============================================
GOOGLE_CLOUD_PROJECT_ID=YOUR_GOOGLE_PROJECT_ID
GOOGLE_CLOUD_CREDENTIALS_PATH=./credentials/google-cloud-key.json
GOOGLE_TRANSLATE_ENABLED=true

# ============================================
# ELEVENLABS TTS
# ============================================
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_monolingual_v1

# ============================================
# STRIPE PAYMENTS
# ============================================
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_PRICE_FREE=price_xxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxx
STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxxx

# ============================================
# SMTP EMAIL
# ============================================
SMTP_HOST=mail.jkhoster.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@jkhoster.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@jkhoster.com
SMTP_FROM_NAME=LearnMind AI
SMTP_ENABLED=true
SMTP_REJECT_UNAUTHORIZED=false

# ============================================
# SECURITY & CORS
# ============================================
CORS_ORIGIN=https://learnmind-ai.jkhoster.com
CORS_CREDENTIALS=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_ROUNDS=12

# ============================================
# FRONTEND CONFIGURATION
# ============================================
VITE_BACKEND_URL=https://learnmind-ai.jkhoster.com
VITE_WEBSOCKET_URL=wss://learnmind-ai.jkhoster.com
VITE_API_URL=https://learnmind-ai.jkhoster.com/api
FRONTEND_URL=https://learnmind-ai.jkhoster.com
VITE_APP_NAME=LearnMind AI
VITE_APP_VERSION=1.0.0

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=

# ============================================
# FEATURES ENABLED
# ============================================
FEATURE_OCR_ENABLED=true
FEATURE_AUDIO_ENABLED=true
FEATURE_SUMMARIZE_ENABLED=true
FEATURE_MINDMAP_ENABLED=true
FEATURE_CONCEPTMAP_ENABLED=true
FEATURE_TRANSLATE_ENABLED=true
FEATURE_TTS_ENABLED=false
FEATURE_GROUPS_ENABLED=true
FEATURE_PAYMENTS_ENABLED=true

# ============================================
# SUBSCRIPTION LIMITS
# ============================================
SUBSCRIPTION_FREE_DOCS_MONTH=5
SUBSCRIPTION_FREE_MAX_FILE_SIZE=10485760
SUBSCRIPTION_PRO_DOCS_MONTH=100
SUBSCRIPTION_PRO_MAX_FILE_SIZE=104857600
SUBSCRIPTION_BUSINESS_DOCS_MONTH=999999
SUBSCRIPTION_BUSINESS_MAX_FILE_SIZE=1073741824

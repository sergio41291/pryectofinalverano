# Frontend Production Environment Configuration
VITE_API_URL=https://learnmind-ai.jkhoster.com/api/v1
VITE_BACKEND_URL=https://learnmind-ai.jkhoster.com
VITE_WEBSOCKET_URL=wss://learnmind-ai.jkhoster.com
VITE_APP_NAME=LearnMind AI
VITE_APP_VERSION=2.1.0

# ============================================
# Feature Flags
# ============================================
VITE_FEATURE_OCR_ENABLED=true
VITE_FEATURE_SUMMARIZE_ENABLED=true
VITE_FEATURE_MINDMAP_ENABLED=true
VITE_FEATURE_CONCEPTMAP_ENABLED=true
VITE_FEATURE_TRANSLATE_ENABLED=true
VITE_FEATURE_TTS_ENABLED=false
VITE_FEATURE_GROUPS_ENABLED=true
VITE_FEATURE_PAYMENTS_ENABLED=true

# ============================================
# API Configuration
# ============================================
VITE_API_TIMEOUT=30000
VITE_ENABLE_API_LOGGING=false

# ============================================
# Upload Configuration
# ============================================
VITE_MAX_FILE_SIZE=104857600
VITE_ALLOWED_FILE_TYPES=pdf,image/jpeg,image/png,image/webp

# ============================================
# Production Configuration
# ============================================
VITE_ENABLE_DEBUG_MODE=false
VITE_LOG_LEVEL=error
